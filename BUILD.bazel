package(default_visibility = ["//visibility:public"])

SUPPORTED_PLATFORMS = [
    "linux_amd64",
    "linux_arm64",
    "osx_amd64",
    "osx_arm64",
]

TARGETS = [
    "microdnf",
    "rpm2archive",
    "lock",
]

[
    alias(
        name = target,
        actual = "//dnf:" + target,
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]
