load("//bazel:platforms.bzl", "SUPPORTED_PLATFORMS")
load("//microdnf:toolchain.bzl", "microdnf_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

microdnf_toolchain(
    name = "toolchain_impl_host",
    lock = "//dnf:lock",
    microdnf = "//dnf:microdnf",
    rpm2archive = "//dnf:rpm2archive",
)

toolchain(
    name = "toolchain_host",
    toolchain = ":toolchain_impl_host",
    toolchain_type = ":toolchain_type",
    visibility = ["//visibility:public"],
)

PLATFORM_CONSTRAINTS = {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "osx_amd64": [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
    "osx_arm64": [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
}

[
    microdnf_toolchain(
        name = "toolchain_impl_" + platform,
        lock = "//dnf:lock_" + platform,
        microdnf = "//dnf:microdnf_" + platform,
        rpm2archive = "//dnf:rpm2archive_" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

[
    toolchain(
        name = "toolchain_" + platform,
        exec_compatible_with = PLATFORM_CONSTRAINTS[platform],
        target_compatible_with = PLATFORM_CONSTRAINTS[platform],
        toolchain = ":toolchain_impl_" + platform,
        toolchain_type = ":toolchain_type",
        visibility = ["//visibility:public"],
    )
    for platform in SUPPORTED_PLATFORMS
]
