{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Group core Bazel rules and platform dependencies",
      "matchPackageNames": [
        "platforms",
        "platforms_contrib",
        "bazel_skylib",
        "bazel_lib",
        "rules_cc"
      ],
      "groupName": "Bazel core rules and platforms"
    },
    {
      "description": "Group hermetic toolchains",
      "matchPackageNames": [
        "llvm",
        "aspect_rules_py",
        "toolchains_buildbuddy"
      ],
      "groupName": "Bazel toolchains"
    },
    {
      "description": "Group BCR leaf C/C++ dependencies",
      "matchPackageNames": [
        "pcre2",
        "libffi",
        "zlib",
        "bzip2",
        "xz",
        "zstd",
        "sqlite3",
        "libyaml",
        "libxml2",
        "libexpat",
        "openssl",
        "curl",
        "libarchive"
      ],
      "groupName": "BCR C/C++ dependencies"
    },
    {
      "description": "Group private index 3rdparty libraries",
      "matchPackageNames": [
        "glib",
        "gobject-introspection",
        "libpeas",
        "smartcols",
        "libgpg-error",
        "libassuan",
        "gpgme",
        "popt",
        "file",
        "json-c",
        "rpm",
        "libsolv",
        "librepo",
        "libmodulemd",
        "libdnf"
      ],
      "groupName": "Private 3rdparty libraries"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track upstream microdnf git repository commit in bazel/extensions.bzl",
      "managerFilePatterns": [
        "/^bazel/extensions\\.bzl$/"
      ],
      "matchStrings": [
        "git_repository\\(\\s*name = \"(?<depName>[^\"]+)\",\\s*remote = \"https://github\\.com/(?<packageName>[^/]+/[^/]+?)(?:\\.git)?\",\\s*commit = \"(?<currentDigest>[0-9a-fA-F]+)\""
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "{{{packageName}}}"
    },
    {
      "customType": "regex",
      "description": "Track upstream GitHub archive releases in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?:v|FILE|popt-|json-c-)?(?<currentValue>[0-9._-]+)\\.tar\\.gz\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track upstream GitHub release downloads in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?:v)?(?<currentValue>[0-9._-]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track upstream GNOME releases for glib, gobject-introspection, libpeas in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://download\\.gnome\\.org/sources/(?<depName>[^/]+)/[0-9.]+/\\k<depName>-(?<currentValue>[0-9.]+)\\.tar\\.xz\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "GNOME/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Track upstream util-linux releases for smartcols in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://mirrors\\.edge\\.kernel\\.org/pub/linux/utils/util-linux/v[0-9.]+/util-linux-(?<currentValue>[0-9.]+)\\.tar\\.xz\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "util-linux/util-linux"
    },
    {
      "customType": "regex",
      "description": "Track upstream RPM releases for rpm in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://ftp\\.osuosl\\.org/pub/rpm/releases/rpm-[0-9.x]+/rpm-(?<currentValue>[0-9.]+)\\.tar\\.bz2\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rpm-software-management/rpm"
    },
    {
      "customType": "regex",
      "description": "Track upstream GnuPG releases for gpgme, libassuan, libgpg-error in bazel/3rdparty/modules",
      "managerFilePatterns": [
        "/^bazel/3rdparty/modules/.*/source\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://gnupg\\.org/ftp/gcrypt/(?<depName>[^/]+)/\\k<depName>-(?<currentValue>[0-9.]+)\\.tar\\.bz2\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "gpg/{{{depName}}}"
    }
  ]
}
