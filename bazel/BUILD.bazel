package(default_visibility = ["//visibility:public"])

exports_files(["gresource.bzl"])

platform(
    name = "ubuntu24_04_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    parents = ["@buildbuddy_toolchain//:platform_linux_x86_64"],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@platforms_contrib//os/linux/libc/glibc:available",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@platforms_contrib//os/linux/libc/glibc:available",
    ],
)

platform(
    name = "osx_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "osx_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)
