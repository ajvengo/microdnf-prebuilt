load("@rules_cc//cc:defs.bzl", "cc_library")

SOLV_COPTS = [
    "-D_GNU_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-DFEDORA=1",
    "-DHAVE_QSORT_R=1",
    "-DHAVE_RPMDBNEXTITERATORHEADERBLOB=1",
    "-DHAVE_RPMDBFSTAT=1",
    "-DWITH_LIBXML2=1",
    "-DENABLE_LINKED_PKGS=1",
    "-DENABLE_COMPLEX_DEPS=1",
    "-DMULTI_SEMANTICS=1",
    "-DENABLE_CONDA=1",
    "-DENABLE_RPMDB=1",
    "-DENABLE_RPMPKG=1",
    "-DENABLE_PUBKEY=1",
    "-DENABLE_RPMMD=1",
    "-DENABLE_RPMPKG_LIBRPM=1",
    "-DENABLE_RPMDB_LIBRPM=1",
    "-DENABLE_RPMDB_BYRPMHEADER=1",
    "-DENABLE_SUSEREPO=1",
    "-DENABLE_COMPS=1",
    "-DENABLE_HELIXREPO=1",
    "-DENABLE_ARCHREPO=1",
    "-DENABLE_DEBIAN=1",
    "-DENABLE_APPDATA=1",
    "-DENABLE_PGPVRFY=1",
    "-DENABLE_ZLIB_COMPRESSION=1",
    "-DENABLE_LZMA_COMPRESSION=1",
    "-DENABLE_BZIP2_COMPRESSION=1",
    "-DENABLE_ZSTD_COMPRESSION=1",
    "-Wno-unused-parameter",
] + select({
    "@platforms//os:macos": ["-DHAVE_STRCHRNUL=1", "-DHAVE_FUNOPEN=1"],
    "//conditions:default": [
        "-DHAVE_STRCHRNUL=1",
        "-DHAVE_FOPENCOOKIE=1",
    ],
})

cc_library(
    name = "libsolv",
    srcs = [
        "src/apk.c",
        "src/bitmap.c",
        "src/chksum.c",
        "src/cleandeps.c",
        "src/conda.c",
        "src/cplxdeps.c",
        "src/decision.c",
        "src/dirpool.c",
        "src/diskusage.c",
        "src/evr.c",
        "src/filelistfilter.c",
        "src/fileprovides.c",
        "src/linkedpkg.c",
        "src/md5.c",
        "src/order.c",
        "src/policy.c",
        "src/pool.c",
        "src/poolarch.c",
        "src/poolid.c",
        "src/poolvendor.c",
        "src/problems.c",
        "src/queue.c",
        "src/repo.c",
        "src/repo_solv.c",
        "src/repo_write.c",
        "src/repodata.c",
        "src/repopage.c",
        "src/rules.c",
        "src/selection.c",
        "src/sha1.c",
        "src/sha2.c",
        "src/solvable.c",
        "src/solver.c",
        "src/solver_util.c",
        "src/solverdebug.c",
        "src/solvversion.c",
        "src/strpool.c",
        "src/suse.c",
        "src/transaction.c",
        "src/userinstalled.c",
        "src/util.c",
    ] + glob(["src/*.h"]),
    hdrs = glob(["src/*.h"]),
    copts = SOLV_COPTS + ["-DLIBSOLV_INTERNAL=1"],
    include_prefix = "solv",
    includes = ["src"],
    strip_include_prefix = "src",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libsolvext",
    srcs = [
        "ext/pool_fileconflicts.c",
        "ext/pool_parserpmrichdep.c",
        "ext/repo_appdata.c",
        "ext/repo_arch.c",
        "ext/repo_comps.c",
        "ext/repo_conda.c",
        "ext/repo_content.c",
        "ext/repo_deb.c",
        "ext/repo_deltainfoxml.c",
        "ext/repo_helix.c",
        "ext/repo_products.c",
        "ext/repo_pubkey.c",
        "ext/repo_releasefile_products.c",
        "ext/repo_repomdxml.c",
        "ext/repo_rpmdb.c",
        "ext/repo_rpmmd.c",
        "ext/repo_susetags.c",
        "ext/repo_testcase.c",
        "ext/repo_updateinfoxml.c",
        "ext/repo_zyppdb.c",
        "ext/repodata_diskusage.c",
        "ext/solv_jsonparser.c",
        "ext/solv_pgpvrfy.c",
        "ext/solv_xfopen.c",
        "ext/solv_xmlparser.c",
        "ext/tarhead.c",
        "ext/testcase.c",
    ] + glob(["ext/*.h"]),
    hdrs = glob(["ext/*.h"]),
    copts = SOLV_COPTS + [
        "-I$(BINDIR)/external/libsolv+/src",
        "-Iexternal/libsolv+/src",
    ],
    include_prefix = "solv",
    includes = ["ext"],
    strip_include_prefix = "ext",
    deps = [
        ":libsolv",
        "@bzip2//:bz2",
        "@libxml2",
        "@rpm//:rpm",
        "@rpm//:rpmio",
        "@xz//:lzma",
        "@zlib",
        "@zstd",
    ],
    visibility = ["//visibility:public"],
)
