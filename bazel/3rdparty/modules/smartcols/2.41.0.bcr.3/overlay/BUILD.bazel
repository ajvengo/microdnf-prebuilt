expand_template(
    name = "libsmartcols_h",
    out = "include/libsmartcols/libsmartcols.h",
    substitutions = {
        "@LIBSMARTCOLS_VERSION@": "2.41.0",
    },
    template = "libsmartcols/src/libsmartcols.h.in",
)

expand_template(
    name = "libsmartcols_internal_h",
    out = "libsmartcols/src/libsmartcols.h",
    substitutions = {
        "@LIBSMARTCOLS_VERSION@": "2.41.0",
    },
    template = "libsmartcols/src/libsmartcols.h.in",
)

cc_library(
    name = "smartcols",
    srcs = [
        "lib/buffer.c",
        "lib/color-names.c",
        "lib/c_strtod.c",
        "lib/encode.c",
        "lib/env.c",
        "lib/fileutils.c",
        "lib/idcache.c",
        "lib/jsonwrt.c",
        "lib/mangle.c",
        "lib/match.c",
        "lib/mbsalign.c",
        "lib/mbsedit.c",
        "lib/md5.c",
        "lib/pwdutils.c",
        "lib/randutils.c",
        "lib/sha1.c",
        "lib/sha256.c",
        "lib/signames.c",
        "lib/strutils.c",
        "lib/strv.c",
        "lib/timeutils.c",
        "lib/ttyutils.c",
        "lib/xxhash.c",
        "libsmartcols/src/calculate.c",
        "libsmartcols/src/cell.c",
        "libsmartcols/src/column.c",
        "libsmartcols/src/filter.c",
        "libsmartcols/src/filter-expr.c",
        "libsmartcols/src/filter-param.c",
        "libsmartcols/src/filter-parser.c",
        "libsmartcols/src/filter-scanner.c",
